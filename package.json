{
  "name": "event-and-activities-express-with-prisma-server",
  "version": "1.0.0",
  "main": "server.js",
  "author": "naeem",
  "license": "MIT",
  "prisma": {
    "schema": "./prisma/schema"
  },
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only ./src/server.ts",
    "build": "tsc",
    "start": "node ./dist/server.js",
    "db:generate": "npx prisma generate --schema=./prisma/schema",
    "db:migrate": "npx prisma migrate deploy --schema=./prisma/schema",
    "db:push": "npx prisma db push --schema=./prisma/schema",
    "db:pull": "npx prisma db pull --schema=./prisma/schema",
    "db:studio": "npx prisma studio --schema=./prisma/schema",
    "postinstall": "npx prisma generate --schema=./prisma/schema",
    "stripe:webhook": "stripe listen --forward-to localhost:5001/webhook"
  },
  "dependencies": {
    "@prisma/client": "^6.16.3",
    "prisma": "^6.16.3",
    "bcryptjs": "^3.0.2",
    "cloudinary": "^2.7.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "http-status": "^2.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "stripe": "^20.0.0",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.5.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.2"
  }
}
